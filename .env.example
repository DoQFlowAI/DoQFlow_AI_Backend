# 이 파일을 .env로 복사해 값을 채웁니다. 실제 값은 커밋하지 마세요.

# Database
DB_URL=
DB_USER=
DB_PASSWORD=

# JWT
JWT_SECRET=

# AI Module
AI_BASE_URL=http://ai-module:8000
AI_INTERNAL_KEY=

# Upload
UPLOAD_DIR=/app/uploads

# CORS
CORS_ORIGINS=

# 회원가입 직급 키 (Day 5 SEC-B 조치 시 사용)
SIGNUP_KEY_LEAD=

# Actuator
ACTUATOR_EXPOSURE=health,info
